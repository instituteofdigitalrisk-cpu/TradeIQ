{
  "expo": {
    "name": "TradeIQ",
    "slug": "digital-risk-academy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tradeiq",
    "icon": "./src/imports/brand-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.tradeiq.draapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/imports/brand-icon.png",
        "backgroundColor": "#060810"
      }
    },
    "splash": {
      "image": "./src/imports/brand-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060810"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "67d275a9-b60c-4965-80a6-4dbcef6ff429"
      }
    }
  }
}